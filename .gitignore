# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# NDK/CMake build cache for the native packages (regenerated by the Gradle
# build; a stale one lingered as 30 MB of orphaned files after the dex/apk
# feature was removed in 0b8bdd43).
**/.cxx/

# Redirected command output (`... > pub_get_log.txt`). `*.log` above doesn't
# cover the .txt spelling.
*_log.txt

# Generated code (build_runner / freezed / json_serializable / drift / riverpod)
# Reproducible via `dart run build_runner build`; not tracked to avoid churn.
*.g.dart
*.freezed.dart

# Flutter tool-generated plugin registrants
**/GeneratedPluginRegistrant.swift
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugins.cmake
